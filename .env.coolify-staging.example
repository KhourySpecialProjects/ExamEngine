# Environment variables for the Coolify STAGING deployment
# (docker-compose.coolify-staging.yml). Set these in the Coolify resource's
# Environment Variables UI. Copy to .env for a local `docker compose` test run.

# REQUIRED — public URL of the app (the domain assigned to the `proxy` service).
# Baked into the frontend bundle at build time and used for backend CORS.
# No trailing slash.
APP_URL=https://examengine-staging.example.com

# Postgres runs in-stack on the persistent `pgdata` volume (survives redeploys).
# CHANGE THE PASSWORD — staging is shared. Changing POSTGRES_USER/DB after the
# volume is first initialized has no effect unless you also reset the volume.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-staging-db
POSTGRES_DB=exam_engine_db

# Backend secret (CHANGE THIS — staging is shared).
SECRET_KEY=change-me-staging-secret

# Seed admin credentials. NOTE: staging does NOT auto-seed (ENVIRONMENT=staging).
# Seed once from the running backend container; it persists in the pgdata volume:
#   python script/add_admin.py
ADMIN_EMAIL=theadmin@northeastern.edu
ADMIN_PASSWORD=change-me-staging-admin

# MinIO (S3-compatible object storage, in-stack on the `miniodata` volume).
# These credentials double as the backend's AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-staging-minio

# S3 bucket + region (created automatically by the minio-init service).
AWS_REGION=us-east-1
AWS_S3_BUCKET=exam-engine-csvs
