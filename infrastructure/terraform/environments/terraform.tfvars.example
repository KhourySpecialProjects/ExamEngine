# Copy this to environments/staging/terraform.tfvars or environments/prod/terraform.tfvars
# and fill in the values for that environment.

# AWS Configuration
aws_region  = "us-east-1"
environment = "staging"  # or "prod"

# Domain
domain_name  = "staging.examengine.nunext.dev"
frontend_url = "https://staging.examengine.nunext.dev"

# S3 Storage
bucket_name = "examengine-datasets-staging"

# RDS Database
db_instance_class = "db.t3.micro"  # use db.t3.small or larger for prod
db_username       = "postgres"
db_password       = "CHANGE_ME_STRONG_PASSWORD"
database_url      = "postgresql+psycopg2://postgres:CHANGE_ME_STRONG_PASSWORD@examengine-staging.xxx.us-east-1.rds.amazonaws.com:5432/exam_engine_db"

# Application Secrets
secret_key = "CHANGE_ME_RANDOM_STRING"  # Generate with: openssl rand -hex 32

# Note: AWS access keys are NOT needed as input variables
# - ECS uses IAM roles for S3 access (automatic)
# - CI/CD uses GitHub Actions OIDC (add github_actions_role_arn output to GitHub repo secrets)
