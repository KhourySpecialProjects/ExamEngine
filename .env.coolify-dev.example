# Environment variables for the Coolify DEVELOPMENT deployment
# (docker-compose.coolify-dev.yml). Set these in the Coolify resource's
# Environment Variables UI. Copy to .env for a local `docker compose` test run.

# REQUIRED — public URL of the app (the domain assigned to the `proxy` service).
# Baked into the frontend bundle at build time and used for backend CORS.
# No trailing slash.
APP_URL=https://examengine-dev.example.com

# Postgres (dev defaults are fine; change the password for anything shared).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=exam_engine_db

# Backend secrets / seed admin (dev).
SECRET_KEY=change-me-dev-secret
ADMIN_EMAIL=theadmin@northeastern.edu
ADMIN_PASSWORD=admin

# MinIO (S3-compatible object storage). These credentials double as the
# backend's AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# S3 bucket + region (created automatically by the minio-init service).
AWS_REGION=us-east-1
AWS_S3_BUCKET=exam-engine-csvs
